<?xml version="1.0" encoding="utf-8"?>
<!-- Benchmark build type only: lets Macrobenchmark read traces. Release and debug are unchanged.
     https://developer.android.com/guide/topics/manifest/profileable-element -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <profileable android:shell="true" tools:targetApi="29" />
    </application>
</manifest>
