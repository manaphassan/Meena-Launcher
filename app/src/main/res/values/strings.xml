    <!-- Prominent Disclosures & Privacy -->
    <string name="disclosure_notification_title">notification access</string>
    <string name="disclosure_notification_body">meena reads incoming notifications solely on your phone to show alerts and chats. your messages and notifications are processed locally in memory and never sent to any server, cloud, or third party.</string>
    <string name="disclosure_notification_question">do you want to open notification access settings?</string>
    <string name="disclosure_location_title">approximate location</string>
    <string name="disclosure_location_body">meena uses your rough location for local weather and prayer times. your rough area goes to open-meteo for the weather and to carto for the map. if your brief includes weather, the place name goes to google. no background tracking.</string>
    <string name="disclosure_location_question">allow location access?</string>
    <string name="disclosure_calendar_title">calendar access</string>
    <string name="disclosure_calendar_body">meena reads your calendar to show today\'s events. if your brief includes calendar, today\'s event titles and times go to google to write it. nothing else leaves your phone.</string>
    <string name="disclosure_calendar_question">allow calendar access?</string>
    <string name="about_privacy_title">privacy charter</string>
    <string name="about_privacy_body">no analytics, no ads and no background tracking. your keys are stored encrypted on your phone. only what weather, prayer times, news, rates and your brief need goes online.</string>
    <string name="privacy_status">no ads · no tracking</string>
    <string name="privacy_intro">meena keeps your data on your phone. a few features need the internet, and each one is listed below.</string>
    <string name="privacy_on_device_body">notifications, bank alerts and health stats are read on your phone and never leave it. calendar, weather and spending only leave if you add them to your brief. no analytics, no ads, no tracking.</string>
    <string name="privacy_notifications_line">notifications and bank alerts: read on your phone and never sent anywhere. if your brief includes spending, only today\'s count and total go to google.</string>
    <string name="privacy_location_line">rough location: used for weather, air quality and the map. open-meteo and carto get your rough area. no background tracking.</string>
    <string name="privacy_calendar_line">calendar: read on your phone to show your agenda. if your brief includes calendar, today\'s event titles and times go to google.</string>
    <string name="privacy_backup_line">no cloud backup: android backup is off, so your settings never sync anywhere.</string>
    <string name="privacy_brief_line">brief: off until you add your own gemini key. then the items you pick go to google each time it updates. your key is stored encrypted.</string>

