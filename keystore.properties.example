# Example keystore configuration for production release signing
# Copy this file to 'keystore.properties' and fill in your upload key details.
# NEVER commit 'keystore.properties' or your .keystore/.jks files to git.

storeFile=upload-keystore.jks
storePassword=change_me_to_your_keystore_password
keyAlias=meena_upload_key
keyPassword=change_me_to_your_key_password
